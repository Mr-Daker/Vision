# Vision — environment template (roadmap V007)
#
# Copy to .env for local development:  cp .env.example .env
# .env is git-ignored. NEVER put a real secret in this file — it is tracked.
# All values below are safe local placeholders.
#
# Secret classification: every value marked [L3c] is a secret under
# docs/foundation/V005-data-privacy-and-retention.md §1 and must be injected
# from a secret manager in any deployed environment, never committed.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# Public API bind address (local only)
API_HOST=127.0.0.1
API_PORT=8080

# Private worker bind address. In a deployed environment this service has NO
# public ingress (V006 §2); locally it is loopback-only.
WORKER_HOST=127.0.0.1
WORKER_PORT=8081

# ---------------------------------------------------------------------------
# Capability mode — controls the simulated/real labels surfaced by the API
# (V002 rows 1 and 16). "simulated" is the only value supported in the
# Hackathon phase; "real" requires V057/V058 approval and credentials.
# ---------------------------------------------------------------------------
IDENTITY_PROVIDER_MODE=simulated
RECIPIENT_PROVIDER_MODE=simulated
AI_PROVIDER_MODE=stub

# ---------------------------------------------------------------------------
# Session service (V009)
# ---------------------------------------------------------------------------
# [L3c] HMAC key for session token hashing. Local placeholder only.
# Generate a real one per environment: openssl rand -hex 32
SESSION_TOKEN_HMAC_KEY=local-dev-session-key-not-a-secret-replace-me
SESSION_TTL_SECONDS=3600
SESSION_COOKIE_NAME=vision_session
SESSION_CSRF_COOKIE_NAME=vision_csrf
# Set to "true" only when served over HTTPS (deployed). Local HTTP needs false.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------------
# Identity mapping (V009) — keyed hash for provider subject references so a
# provider reference is never stored or logged in clear form (V003 IdentityMapping)
# ---------------------------------------------------------------------------
# [L3c] Local placeholder only.
IDENTITY_MAPPING_HMAC_KEY=local-dev-identity-key-not-a-secret-replace-me

# ---------------------------------------------------------------------------
# Configuration packs (V001 Appendix G) — scope is data, not code
# ---------------------------------------------------------------------------
JURISDICTION_PROFILE_ID=demo-district-a
# Optional comma-separated subset for reviewer grants. When omitted, the
# reviewed nodes in the selected profile pack are used; no database-discovered
# jurisdictions are silently added to a reviewer's scope.
REVIEWER_JURISDICTION_CODES=
# Optional exact staff scopes as jurisdiction-code:department-id pairs,
# comma-separated. When omitted, pairs come from the selected versioned
# routing pack. These become durable server-side grants, never client claims.
STAFF_RESPONSIBILITIES=
# Separate cookies let citizen, reviewer and department workspaces stay open.
REVIEWER_SESSION_COOKIE_NAME=vision_reviewer_session
REVIEWER_CSRF_COOKIE_NAME=vision_reviewer_csrf
STAFF_SESSION_COOKIE_NAME=vision_staff_session
STAFF_CSRF_COOKIE_NAME=vision_staff_csrf
LOCALE_PACK_VERSION=demo-locales.v1
# Which interface languages this deployment accepts. Required: the API refuses
# to start without it rather than assuming a language set in code.
SUPPORTED_LOCALES=en-IN,mr-IN
TAXONOMY_PACK_VERSION=demo-taxonomy.v1
# The worker loads boundary and routing versions from the selected profile's
# reviewed pack; they are not independently overridden because mismatched
# versions would make an otherwise explainable route impossible to reproduce.

# ---------------------------------------------------------------------------
# PostgreSQL — live since V012/V013. The credentials must match
# docker-compose.yml, which is what `npm run db:up` starts.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://vision:vision_local_dev_only@127.0.0.1:5432/vision_dev
DATABASE_POOL_MAX=5
DATABASE_STATEMENT_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Object storage — local filesystem adapter until V016/V051
# ---------------------------------------------------------------------------
OBJECT_STORE_DRIVER=filesystem
OBJECT_STORE_ROOT=./local-object-store

# ---------------------------------------------------------------------------
# Gemini — NOT used before V023. Leave empty locally; the stub provider is
# used when AI_PROVIDER_MODE=stub. [L3c] when populated.
# ---------------------------------------------------------------------------
# A blank value is NOT the same as an absent one: the adapters refuse to
# construct with an empty model name rather than calling `/models/:generate`
# and reporting a permanent misconfiguration as a retryable outage.
GEMINI_API_KEY=
# Multimodal classification model. `gemini-2.5-flash` is retired to new users.
GEMINI_CLASSIFICATION_MODEL=gemini-3.6-flash
# Audio transcription model (V024). Untested against real audio so far.
GEMINI_TRANSCRIPTION_MODEL=gemini-3.5-transcribe
# Embeddings (V023 -> V026). The width must be recorded, because a vector of
# unexpected width stored beside correct ones corrupts every later comparison.
# Measured: gemini-embedding-001 returns 3072 dimensions, already unit length.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMENSIONS=3072
# Hard ceiling on paid calls per process, so a crash-retry loop cannot run up
# a bill (V006 §12 consequence 6). Empty means unbounded; set it in deployment.
GEMINI_MAX_CALLS=
